{
  "name": "dsh-workbench-pm-plan",
  "version": "1.4.0",
  "private": true,
  "description": "项目计划工作台：多端项目的需求变更工单、工作计划、跟进事项、需求文档库、风险与周季报，一屏管到底。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Westergren/pm-plan.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "yun-kun",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh/",
    "lib/",
    "src/shared/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-workbench-package.mjs",
    "verify": "node scripts/build-client.mjs && node --test test/*.test.mjs && node scripts/check-workbench-package.mjs",
    "pack:local": "pnpm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "jsdom": "^30.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
